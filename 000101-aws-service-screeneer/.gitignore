# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*


# Editors / IDEs

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace


# Node (if tooling such as PostCSS is added later)

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/


# Secrets / env (never commit AWS credentials)

*.pem
*.key
.aws/
credentials
credentials.csv
*_accessKeys.csv


