
# Hugo build output (regenerated by `hugo` / `hugo server`)

/public/
/resources/_gen/
/assets/jsconfig.json
.hugo_build.lock
hugo_stats.json

# Hugo binaries (if downloaded locally)
/hugo
/hugo.exe
/bin/

# Hugo modules cache (if modules are used later)
/_vendor/
.hugo_cache/


# AI / tooling generated context

# codesight output is regenerated by scanning the repo
/.codesight/

# Kiro workflow run artifacts (keep .kiro/steering, hooks, specs tracked)
/.agents/
/.worktrees/
.kiro
.agent


# Backup & temp files

*.bkp
*.bak
*.tmp
*.temp
*.orig
*.rej
*.swp
*.swo
*~
.$*
~$*


